# Application Port & URLs
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# JWT Authentication Secret (Use a strong random 256-bit string in production)
JWT_SECRET="your-256-bit-secret-key-change-in-production"

# PostgreSQL Database Connection String (for macOS Monterey / Production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshmart?schema=public"

# SQLite Database URL (used for instant live preview inside container)
SQLITE_DATABASE_URL="file:./prisma/dev.db"

# Admin Initial Seed Credentials (used by prisma/seed.ts)
INITIAL_ADMIN_EMAIL="admin@freshmart.local"
INITIAL_ADMIN_PASSWORD="AdminFresh2026!"

